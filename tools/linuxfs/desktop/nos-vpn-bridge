#!/usr/bin/python3
"""openconnect --script-tun helper: carries the tunnel's packets to an Android VPN interface.

openconnect runs this with the tunnel's settings in its environment (INTERNAL_IP4_*, CISCO_SPLIT_INC_*,
VPNGATEWAY) and the packet socket in VPNFD. The N-OS app owns Android's VpnService: this asks it, over
its abstract socket, for a tun interface built from those settings, receives the interface's file
descriptor, and copies packets both ways until either side closes.
"""
import json
import os
import selectors
import socket
import sys

SOCKET_FILE = "/etc/droiddeck/bwrap-socket"


def app_socket():
    try:
        with open(SOCKET_FILE, encoding="utf-8") as f:
            name = f.read().strip()
    except OSError:
        name = os.environ.get("DROIDDECK_BWRAP_SOCKET", "")
    return "\0" + (name or "com.droiddeck.launcher.bwrap") + ".vpn"


def split_routes(prefix):
    routes = []
    for i in range(int(os.environ.get(prefix, "0") or 0)):
        addr = os.environ.get(f"{prefix}_{i}_ADDR")
        bits = os.environ.get(f"{prefix}_{i}_MASKLEN")
        if addr and bits:
            routes.append(f"{addr}/{bits}")
    return routes


def settings():
    return {
        "address": os.environ.get("INTERNAL_IP4_ADDRESS", ""),
        "netmasklen": int(os.environ.get("INTERNAL_IP4_NETMASKLEN", "32") or 32),
        "mtu": int(os.environ.get("INTERNAL_IP4_MTU", "1400") or 1400),
        "dns": os.environ.get("INTERNAL_IP4_DNS", "").split(),
        "domains": (os.environ.get("CISCO_DEF_DOMAIN", "") + " " + os.environ.get("CISCO_SPLIT_DNS", "").replace(",", " ")).split(),
        "routes": split_routes("CISCO_SPLIT_INC"),
        "excludes": split_routes("CISCO_SPLIT_EXC"),
        "gateway": os.environ.get("VPNGATEWAY", ""),
    }


def log(message):
    print(f"nos-vpn-bridge: {message}", file=sys.stderr, flush=True)


def main():
    if os.environ.get("reason") not in (None, "", "connect"):
        return 0
    vpnfd = int(os.environ["VPNFD"])
    conf = settings()
    if not conf["address"]:
        log("openconnect gave no IPv4 address; nothing to set up")
        return 1
    control = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        control.connect(app_socket())
    except OSError as e:
        log(f"the N-OS app is not answering ({e}); tap Connect on the Network tab again")
        return 1
    control.sendall(json.dumps(conf).encode() + b"\n")
    msg, fds, _, _ = socket.recv_fds(control, 4096, 1)
    if not fds:
        log("Android did not give a VPN interface: " + msg.decode(errors="replace").strip())
        return 1
    tun = fds[0]
    routes = ", ".join(conf["routes"]) or "all traffic"
    log(f"tunnel up: {conf['address']} on the Android VPN, routes {routes}")
    sel = selectors.DefaultSelector()
    sel.register(vpnfd, selectors.EVENT_READ, tun)
    sel.register(tun, selectors.EVENT_READ, vpnfd)
    sel.register(control, selectors.EVENT_READ, None)
    while True:
        for key, _ in sel.select():
            if key.data is None:
                if not control.recv(64):
                    log("the N-OS app closed the VPN")
                    return 0
                continue
            try:
                packet = os.read(key.fd, 65535)
            except OSError as e:
                log(f"read failed: {e}")
                return 1
            if not packet:
                log("tunnel closed")
                return 0
            try:
                os.write(key.data, packet)
            except OSError:
                pass


if __name__ == "__main__":
    sys.exit(main())
