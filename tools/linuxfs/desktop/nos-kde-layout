    <rect x="13" y="27" width="10" height="10" rx="3" fill="#34AADC"/><rect x="27" y="27" width="10" height="10" rx="3" fill="#5856D6"/><rect x="41" y="27" width="10" height="10" rx="3" fill="#FF2D92"/>
    <rect x="13" y="41" width="10" height="10" rx="3" fill="#FFCC00"/><rect x="27" y="41" width="10" height="10" rx="3" fill="#5AC8FA"/><rect x="41" y="41" width="10" height="10" rx="3" fill="#8E8E93"/>
