#!/bin/bash
# GNOME Shell 50 has no nested mode. In --devkit mode it runs on a virtual monitor and
# mutter starts its viewer (mutter-devkit), a Wayland client on the app's compositor that
# shows the desktop from a PipeWire screencast stream.
set -u
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=GNOME XDG_SESSION_DESKTOP=gnome DESKTOP_SESSION=gnome
# The viewer is a screencast, so the stock panel offers a "stop sharing" button that ends the whole
# desktop. The nos mode is Ubuntu's mode without that button, the welcome tour or snap helpers.
if [ -f /usr/share/gnome-shell/modes/ubuntu.json ]; then
  cat > /usr/share/gnome-shell/modes/nos.json <<'MODE'
{
    "parentMode": "user",
    "stylesheetName": "Yaru/gnome-shell.css",
    "colorScheme": "prefer-light",
    "themeResourceName": "theme/Yaru/gnome-shell-theme.gresource",
    "iconsResourceName": "theme/Yaru/gnome-shell-icons.gresource",
    "showWelcomeDialog": false,
    "panel": {
        "left": ["activities"],
        "center": ["dateMenu"],
        "right": ["screenRecording", "dwellClick", "a11y", "keyboard", "quickSettings"]
    },
    "enabledExtensions": [
        "ubuntu-dock@ubuntu.com",
        "ubuntu-appindicators@ubuntu.com",
        "ding@rastersoft.com",
        "tiling-assistant@ubuntu.com"
    ]
}
MODE
  export XDG_CURRENT_DESKTOP=ubuntu:GNOME XDG_SESSION_DESKTOP=ubuntu DESKTOP_SESSION=ubuntu GNOME_SHELL_SESSION_MODE=nos
fi
export GDK_BACKEND=wayland,x11 QT_QPA_PLATFORM="wayland;xcb"
unset KDE_FULL_SESSION KDE_SESSION_VERSION KWIN_COMPOSE QT_QUICK_BACKEND
host_display=${WAYLAND_DISPLAY:-wayland-0}
mkdir -p "$HOME/Desktop" 2>/dev/null

# The shell uses logind only when this directory exists; the runtime has no logind.
rm -rf /run/systemd/seats 2>/dev/null

# The app writes its own /etc/passwd without a messagebus user, so the stock system.conf cannot start.
if [ ! -S /run/dbus/system_bus_socket ]; then
  mkdir -p /run/dbus /usr/local/share/droiddeck
  cat > /usr/local/share/droiddeck/system-bus.conf <<'BUSCONF'
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>system</type>
  <listen>unix:path=/run/dbus/system_bus_socket</listen>
  <auth>EXTERNAL</auth>
  <policy context="default">
    <allow user="*"/>
    <allow own="*"/>
    <allow send_destination="*"/>
    <allow receive_sender="*"/>
  </policy>
</busconfig>
BUSCONF
  rm -f /run/dbus/system_bus_socket /run/dbus/pid
  dbus-daemon --config-file=/usr/local/share/droiddeck/system-bus.conf --fork --nopidfile
  for _ in $(seq 50); do [ -S /run/dbus/system_bus_socket ] && break; sleep 0.1; done
  [ -S /run/dbus/system_bus_socket ] || { echo "== gnome: the system bus did not come up; the shell cannot start"; exit 70; }
fi

[ -f /usr/share/glib-2.0/schemas/gschemas.compiled ] || glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null

echo "== nos-gnome-session: GNOME on $host_display; the viewer sizes the monitor"
exec dbus-run-session -- bash -c '
  pipewire >"${BL_DEBUG_DIR:-/tmp}/gnome-pipewire.log" 2>&1 &
  for _ in $(seq 50); do [ -S "$XDG_RUNTIME_DIR/pipewire-0" ] && break; sleep 0.1; done
  wireplumber >"${BL_DEBUG_DIR:-/tmp}/gnome-wireplumber.log" 2>&1 &
  WAYLAND_DISPLAY='"$host_display"' gnome-shell --devkit
'
